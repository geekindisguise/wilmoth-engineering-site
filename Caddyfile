{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}
	root * /usr/share/caddy
	encode gzip
	@reviewdemo path /snap-and-wind/review-demo.mp4
	header @reviewdemo X-Robots-Tag "noindex, nofollow, noarchive"
	# Icon types, set explicitly so they don't depend on the image's mime table
	# (file_server keeps a Content-Type that is already set).
	@ico path *.ico
	header @ico Content-Type image/x-icon
	@svg path *.svg
	header @svg Content-Type image/svg+xml
	@webmanifest path *.webmanifest
	header @webmanifest Content-Type application/manifest+json
	try_files {path} {path}.html {path}/index.html
	file_server
}
